{
  "name": "api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "vars": {"ALLOWED_ORIGINS": "https://valen-team.github.io"},
  "ratelimits": [
    {"name": "PER_IP", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}},
    {"name": "SHARED_BUDGET", "namespace_id": "1002", "simple": {"limit": 60, "period": 60}}
  ],
  "observability": {"enabled": false}
}
