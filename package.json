{
  "name": "valen-team-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/check-design.mjs && node scripts/search-index.mjs",
    "start": "docusaurus start --host 127.0.0.1",
    "prebuild": "python3 scripts/check-cookbook.py --bundle && node scripts/check-design.mjs && node scripts/search-index.mjs",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check-links": "node scripts/check-links.mjs",
    "design:check": "node scripts/check-design.mjs",
    "design:verify-source": "node scripts/check-design.mjs --source ../design-system",
    "preview:local": "node scripts/preview-local.mjs",
    "test:ask": "node --test tests/ask-decision.test.mjs",
    "test:cookbook": "python3 scripts/check-cookbook.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.0.5",
    "tinypool": "^2.1.2",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0"
  }
}
